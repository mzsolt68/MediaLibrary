@model MediaLibrary.ViewModels.Audio.AlbumDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

<h2>Details</h2>

<div>
    <h4>Album</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Album.AlbumTitle)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Album.AlbumTitle)
        </dd>
    </dl>
    <hr />
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Zeneszám címe</th>
                <th>Előadó</th>
                <th>Játékidő</th>
            </tr>
        </thead>
        @foreach (var song in Model.Details)
        {
            string performer = "";
            foreach (var perf in song.Song.PerformerSongs)
            {
                performer = perf.Performer.PerformerName;
            }
            <tr>
                <td>@song.Song.SongTitle</td>
                <td>@performer</td>
                <td>@song.PlayTime.ToShortTimeString()</td>
            </tr>
        }
    </table>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Album.AlbumID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
