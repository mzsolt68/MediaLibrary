@model MediaLibrary.ViewModels.Audio.AlbumEditViewModel

@{
    ViewData["Title"] = "Create";
}

<h2>Új album</h2>

<h4>Album</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Album.AlbumTitle" class="control-label"></label>
                <input asp-for="Album.AlbumTitle" class="form-control" />
                <span asp-validation-for="Album.AlbumTitle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Album.NrOfDiscs" class="control-label"></label>
                <input asp-for="Album.NrOfDiscs" class="form-control" />
                <span asp-validation-for="Album.NrOfDiscs" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Album.AlbumFormat" class="control-label"></label>
                @Html.DropDownListFor(x => Model.AudioFormatID, new SelectList(Model.AudioFormats, "Value", "Text"), htmlAttributes: new { @class = "form-control", id = "AudioFoarmatID" })
            </div>
            <div class="form-group">
                <input type="submit" value="Létrehozás" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Vissza a listához</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
