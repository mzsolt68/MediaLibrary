@model IEnumerable<MediaLibrary.Models.Audio.Album>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Új album hozzáadása</a>
</p>
<table class="table table-condensed">
    <thead>
        <tr>
            <th class="col-xs-3" style="text-align:center">
                @Html.DisplayNameFor(model => model.AlbumTitle)
            </th>
            <th class="col-xs-2" style="text-align:center">
                @Html.DisplayNameFor(model => model.NrOfDiscs)
            </th>
            <th class="col-xs-1" style="text-align:center">
                @Html.DisplayNameFor(model => model.AlbumSongs)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td style="text-align:center">
                @Html.DisplayFor(modelItem => item.AlbumTitle)
            </td>
            <td style="text-align:center">
                @Html.DisplayFor(modelItem => item.NrOfDiscs)
            </td>
            <td style="text-align:center">
                @item.AlbumSongs.Count()
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AlbumID">Szerkesztés</a> |
                <a asp-action="Details" asp-route-id="@item.AlbumID">Részletek</a> |
                <a asp-action="Delete" asp-route-id="@item.AlbumID">Törlés</a>
            </td>
        </tr>
}
    </tbody>
</table>
