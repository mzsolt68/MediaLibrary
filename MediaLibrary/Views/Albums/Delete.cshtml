@model MediaLibrary.ViewModels.Audio.AlbumDetailsViewModel

@{
    ViewData["Title"] = "Delete";
}

<h2>Törlés</h2>

<h3>Biztosan törölni akarja ezt az albumot?</h3>
@{await Html.RenderPartialAsync("Audio/AlbumDetailsPartial", Model);}
<div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Album.AlbumID" />
        <input type="submit" value="Törlés" class="btn btn-danger" /> |
        <a asp-action="Index">Vissza a listához</a>
    </form>
</div>
