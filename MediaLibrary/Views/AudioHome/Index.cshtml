
<h2>Audio library főoldal</h2>

<div class="panel panel-primary">
    <div class="panel-heading">Főmenű</div>
    <div class="panel-body">
        <div class="btn-group">
            <div class="col-xs-4"><a class="btn btn-primary btn-lg" href="Performers">Előadók (@ViewData["nrofperformers"])</a></div>
            <div class="col-xs-4"><a class="btn btn-primary btn-lg" href="Albums">Albumok (@ViewData["nrofalbums"])</a></div>
            <div class="col-xs-4"><a class="btn btn-primary btn-lg" href="Songs">Zeneszámok (@ViewData["nrofsongs"])</a></div>
            @if (User.Identity.IsAuthenticated)
            {
                <div class="col-xs-2">
                    <br />
                    <a class="btn btn-primary btn-lg" href="AudioFormats">Formátumok</a>
                </div>
            }
        </div>
    </div>
</div>