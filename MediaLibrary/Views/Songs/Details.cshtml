@model MediaLibrary.ViewModels.Audio.SongDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

<h2>Részletek</h2>

<div>
    <h4>Dal</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Song.SongTitle)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Song.SongTitle)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Song.SongLiryc)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Song.SongLiryc)
        </dd>
        <dt>
            @Html.DisplayName("Előadó(k):")
        </dt>
        @foreach(var perf in Model.PerformersOfSong)
        {
            <dd>
                @perf.PerformerName
            </dd>
        }
        <dt>
            @Html.DisplayName("Album(ok):")
        </dt>
        @foreach(var alb in Model.AlbumsOfSong)
        {
            <dd>
                @alb.AlbumTitle (@alb.AlbumFormat.AudioFormatName)
            </dd>
        }
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Song.SongID">Szerkesztés</a> |
    <a asp-action="Index">Vissza a listához</a>
</div>
