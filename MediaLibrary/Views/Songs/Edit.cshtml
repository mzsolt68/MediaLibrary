@model MediaLibrary.ViewModels.Audio.SongEditViewModel

@{
    ViewData["Title"] = "Edit";
}

<h2>Szerkesztés</h2>

<h4>Dal</h4>
<hr />
<div class="row">
    <div class="panel panel-default col-md-4">
        <div class="panel-heading">
            <h3 class="panel-title">Választható előadók</h3>
        </div>
        <div class="row panel-body">
            <div class="col-md-8">
                <select class="form-control" id="SelectedPerformer" asp-for="SelectedPerformerID" asp-items="Model.PerformerList"></select>
            </div>
            <div class="col-md-1">
                <button type="button" id="AddPerformer" class="btn btn-default">Hozzáadás</button>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="panel panel-default col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Song.SongID" />
            <div class="form-group">
                <label asp-for="Performers" class="control-label"></label>
                <br />
                <div id="songperformers">
                    @for (int i = 0; i < Model.Performers.Count; i++)
                    {
                        Html.RenderPartial("Audio/PerformerListPartial", Model.Performers[i]);
                    }
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Song.SongTitle" class="control-label"></label>
                <input asp-for="Song.SongTitle" class="form-control" />
                <span asp-validation-for="Song.SongTitle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Song.SongLiryc" class="control-label"></label>
                <textarea asp-for="Song.SongLiryc" class="form-control"></textarea>
                <span asp-validation-for="Song.SongLiryc" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Mentés" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Vissza a listához</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
