@model MediaLibrary.ViewModels.Audio.SongEditViewModel

@{
    ViewData["Title"] = "Edit";
}

<h2>Szerkesztés</h2>

<h4>Dal</h4>
<hr />
<div class="row PerformerSelector">
    <div class="panel panel-default col-md-4">
        @{await Html.RenderPartialAsync("Audio/PerformerSelectPartial", Model.PerformerList); }
    </div>
</div>
<div class="row">
    <div class="panel panel-default col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Song.SongID" />
            @{await Html.RenderPartialAsync("Audio/SongEditPartial", Model);}
            <div class="form-group">
                <input type="submit" value="Mentés" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Vissza a listához</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
