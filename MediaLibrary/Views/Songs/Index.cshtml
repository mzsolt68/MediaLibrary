@model IEnumerable<MediaLibrary.Models.Audio.Song>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-condensed">
    <thead>
        <tr>
            <th style="text-align:center">
                @Html.DisplayNameFor(model => model.SongTitle)
            </th>
            <th style="text-align:center">
                @Html.DisplayName("Előadó(k)")
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td style="vertical-align:middle">
                @Html.DisplayFor(modelItem => item.SongTitle)
            </td>
            <td>
                @foreach(var ps in item.PerformerSongs)
                {
                    @Html.DisplayName($"{ps.Performer.PerformerName}")<br /> 
                }
            </td>
            <td style="vertical-align:middle">
                <a asp-action="Edit" asp-route-id="@item.SongID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.SongID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.SongID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
