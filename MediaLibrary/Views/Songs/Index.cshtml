@model IEnumerable<MediaLibrary.Models.Audio.Song>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Új dal hozzáadása</a>
</p>
<div class="row">
    <div class="col-xs-8">
        <table class="table table-condensed">
            <thead>
                <tr>
                    <th class="col-xs-4" style="text-align:center">
                        @Html.DisplayNameFor(model => model.SongTitle)
                    </th>
                    <th class="col-xs-4" style="text-align:center">
                        @Html.DisplayName("Előadó(k)")
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="vertical-align:middle; text-align:center">
                            @Html.DisplayFor(modelItem => item.SongTitle)
                        </td>
                        <td style="vertical-align:middle; text-align:center">
                            @foreach (var ps in item.PerformerSongs)
                            {
                                @Html.DisplayName($"{ps.Performer.PerformerName}")<br />
                            }
                        </td>
                        <td style="vertical-align:middle">
                            <a asp-action="Edit" asp-route-id="@item.SongID">Szerkesztés</a> |
                            <a asp-action="Details" asp-route-id="@item.SongID">Részletek</a> |
                            <a asp-action="Delete" asp-route-id="@item.SongID">Törlés</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>