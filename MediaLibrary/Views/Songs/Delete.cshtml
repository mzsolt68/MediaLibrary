@model MediaLibrary.ViewModels.Audio.SongDetailsViewModel

@{
    ViewData["Title"] = "Delete";
}

<h2>Törlés</h2>

<h3>Biztosan törölni akarja ezt a dalt?</h3>
<div>
    @{ await Html.RenderPartialAsync("Audio/SongDetailsPartial", Model);}
    <form asp-action="Delete">
        <input type="hidden" asp-for="Song.SongID" />
        <input type="submit" value="Törlés" class="btn btn-danger" /> |
        <a asp-action="Index">Vissza a listához</a>
    </form>
</div>
