@model MediaLibrary.Models.Audio.Song

@{
    ViewData["Title"] = "Delete";
}

<h2>Törlés</h2>

<h3>Biztosan törölni akarja ezt a dalt?</h3>
<div>
    <h4>Song</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.SongTitle)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.SongTitle)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.SongLiryc)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.SongLiryc)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="SongID" />
        <input type="submit" value="Törlés" class="btn btn-default" /> |
        <a asp-action="Index">Vissza a listához</a>
    </form>
</div>
