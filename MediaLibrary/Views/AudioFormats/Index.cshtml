@model IEnumerable<MediaEntities.Models.Audio.AudioFormat>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-condensed">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AudioFormatName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.AudioFormatName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AudioFormatID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.AudioFormatID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.AudioFormatID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
