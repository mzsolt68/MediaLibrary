@model MediaLibrary.Entities.Models.Audio.SongPerformer

@{
    ViewData["Title"] = "Edit";
}

<h2>Szerkesztés</h2>

<h4>Előadó</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PerformerID" />
            <div class="form-group">
                <label asp-for="PerformerName" class="control-label"></label>
                <input asp-for="PerformerName" class="form-control" />
                <span asp-validation-for="PerformerName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Mentés" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Vissza a listához</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
