@model MediaLibrary.ViewModels.Audio.PerformerDetailsViewModel

@{
    ViewData["Title"] = "Delete";
}

<h2>Törlés</h2>

<h3>Biztosan törölni akarja ezt az előadót?</h3>

@{await Html.RenderPartialAsync("Audio/PerformerDetailsPartial", Model);}

<div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Performer.PerformerID" />
        <input type="submit" value="Törlés" class="btn btn-default" /> |
        <a asp-action="Index">Vissza a listához</a>
    </form>
</div>
