@model IEnumerable<MediaEntities.Models.Audio.Performer>

@{
    ViewData["Title"] = "Index";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Új előadó hozzáadása</a>
</p>
<table class="table table-condensed">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PerformerName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PerformerSongs)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PerformerName)
            </td>
            <td>
                @item.PerformerSongs.Count()
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PerformerID">Szerkesztés</a> |
                <a asp-action="Details" asp-route-id="@item.PerformerID">Részletek</a> |
                <a asp-action="Delete" asp-route-id="@item.PerformerID">Törlés</a>
            </td>
        </tr>
}
    </tbody>
</table>
