@model MediaLibrary.ViewModels.Audio.AlbumDetailsViewModel

<div>
    <h4>Album</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Album.AlbumTitle)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Album.AlbumTitle)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Album.AlbumFormat)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Album.AlbumFormat.AudioFormatName)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Album.NrOfDiscs)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Album.NrOfDiscs)
        </dd>
    </dl>
    <hr />
    <table class="table table-condensed">
        <thead>
            <tr>
                <th class="col-xs-1" style="text-align:center">Sorszám</th>
                <th class="col-xs-4" style="text-align:center">Zeneszám címe</th>
                <th class="col-xs-2" style="text-align:center">Előadó</th>
                <th class="col-xs-1" style="text-align:center">Játékidő</th>
                <th class="col-xs-1" style="text-align:center">Lemez</th>
            </tr>
        </thead>
        @foreach (var song in Model.Details)
        {
            <tr>
                <td style="text-align:center">@song.TrackNr</td>
                <td style="text-align:center">@song.Song.SongTitle</td>
                <td style="text-align:center">
                    @foreach (var perf in song.Song.PerformerSongs)
                    {
                        @Html.DisplayName($"{perf.Performer.PerformerName}")<br />
                    }
                </td>
                <td style="text-align:center">@song.PlayTime.ToShortTimeString()</td>
                <td style="text-align:center">@song.Disc</td>
            </tr>
        }
    </table>
</div>
