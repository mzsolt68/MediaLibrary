@model MediaLibrary.ViewModels.Audio.PerformerDetailsViewModel

<div>
    <h4>Előadó</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Performer.PerformerName)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Performer.PerformerName)
        </dd>
    </dl>
    <hr />
    <table class="table table-condensed">
        <thead>
            <tr>
                <th class="col-xs-4" style="text-align:center">Zeneszám címe</th>
                <th class="col-xs-2" style="text-align:center">Album</th>
            </tr>
        </thead>
        @foreach (var item in Model.Songs)
        {
            <tr>
                <td style="text-align:center">@item.Song.SongTitle</td>
                <td style="text-align:center">
                    @foreach (var alb in item.Song.AlbumSongs)
                    {
                        @Html.DisplayName($"{alb.Album.AlbumTitle}")<br />
                    }
                </td>
            </tr>
        }
    </table>
</div>