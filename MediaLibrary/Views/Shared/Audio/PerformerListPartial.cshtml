@model MediaLibrary.ViewModels.Audio.SongPerformerViewModel
@using HtmlHelpers.BeginCollectionItemCore

@using (Html.BeginCollectionItem("Performers"))
{
    <div class="row PerformerRow">
        <input type="hidden" asp-for="Performer.PerformerID" />
        <div class="col-md-8">
            <input class="form-control" readonly asp-for="Performer.PerformerName" />
        </div>
        <div class="col-md-1 DeletePerformer">
            <button type="button" class="btn btn-danger" id="DeletePerformer">Törlés</button>
        </div>
    </div>
}