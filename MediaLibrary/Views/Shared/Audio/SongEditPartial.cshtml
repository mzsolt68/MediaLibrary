@model MediaLibrary.ViewModels.Audio.SongEditViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="form-group">
    <label asp-for="Performers" class="control-label"></label>
    <br />
    <div id="songperformers">
        @foreach (var item in Model.Performers)
        {
            await Html.RenderPartialAsync("Audio/PerformerListPartial", item);
        }
    </div>
</div>
<div class="form-group">
    <label asp-for="Song.SongTitle" class="control-label"></label>
    <input asp-for="Song.SongTitle" class="form-control" />
    <span asp-validation-for="Song.SongTitle" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Song.SongLyric" class="control-label"></label>
    <textarea asp-for="Song.SongLyric" class="form-control"></textarea>
    <span asp-validation-for="Song.SongLyric" class="text-danger"></span>
</div>
