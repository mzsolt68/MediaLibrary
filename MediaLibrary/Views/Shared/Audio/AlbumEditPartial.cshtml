@model MediaLibrary.ViewModels.Audio.AlbumEditViewModel
<div class="col-md-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Album.AlbumTitle" class="control-label"></label>
        <input asp-for="Album.AlbumTitle" class="form-control" />
        <span asp-validation-for="Album.AlbumTitle" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Album.NrOfDiscs" class="control-label"></label>
        <input asp-for="Album.NrOfDiscs" class="form-control" />
        <span asp-validation-for="Album.NrOfDiscs" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Album.AlbumFormat" class="control-label"></label>
        @Html.DropDownListFor(x => Model.AudioFormatID, new SelectList(Model.AudioFormats, "Value", "Text"), htmlAttributes: new { @class = "form-control", id = "AudioFoarmatID" })
    </div>
    <div class="form-group">
        <a href="#" class="btn btn-default" data-toggle="modal" data-target="#newSongModal">Új zeneszám hozzáadása</a>
    </div>
</div>
<div id="AlbumSongs">
    <table class="table table-condensed">
        <thead>
            <tr>
                <th class="col-xs-1"> </th>
                <th class="col-xs-1" style="text-align:center">Sorszám</th>
                <th class="col-xs-4" style="text-align:center">Zeneszám címe</th>
                <th class="col-xs-2" style="text-align:center">Előadó</th>
                <th class="col-xs-1" style="text-align:center">Játékidő</th>
                <th class="col-xs-1" style="text-align:center">Lemez</th>
                <th></th>
            </tr>
        </thead>
        @foreach (var item in Model.Songs)
        {
            await Html.RenderPartialAsync("Audio/SongListPartial", item);
        }
    </table>
</div>
<div class="modal fade" id="newSongModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <a href="#" class="close" data-dismiss="modal">&times;</a>
                <h3 class="modal-title">Zeneszám választás</h3>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button class="btn btn-success">Hozzáadás</button>
                <button class="btn btn-default" data-dismiss="modal">Mégsem</button>
            </div>
        </div>
    </div>
</div>