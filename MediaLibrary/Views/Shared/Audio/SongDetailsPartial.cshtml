@model MediaLibrary.ViewModels.Audio.SongDetailsViewModel

<h4>Dal</h4>
<hr />
<dl class="dl-horizontal">
    <dt>
        @Html.DisplayNameFor(model => model.Song.SongTitle)
    </dt>
    <dd>
        @Html.DisplayFor(model => model.Song.SongTitle)
    </dd>
    <dt>
        @Html.DisplayNameFor(model => model.Song.SongLyric)
    </dt>
    <dd>
        @Html.DisplayFor(model => model.Song.SongLyric)
    </dd>
    <dt>
        @Html.DisplayNameFor(model => model.PerformersOfSong)
    </dt>
    @foreach (var perf in Model.PerformersOfSong)
    {
        <dd>
            @perf.PerformerName
        </dd>
    }
    <dt>
        @Html.DisplayNameFor(model => model.AlbumsOfSong)
    </dt>
    @foreach (var alb in Model.AlbumsOfSong)
    {
        <dd>
            @alb.AlbumTitle (@alb.AlbumFormat.AudioFormatName)
        </dd>
    }
</dl>